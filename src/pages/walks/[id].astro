---
import { getCollection } from 'astro:content';
import { walkTitle } from '../../walkTitle';
import WalkPath from '../../WalkPath.astro';

export async function getStaticPaths() {
  const walks = await getCollection('walks');
  return walks.map((walk) => ({ params: { id: walk.id }, props: { walk } }));
}

const { walk } = Astro.props;
const title = walkTitle(walk.data.startTime, walk.data.endTime);
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    <p><a href="/">← All walks</a></p>
    <h1>{title}</h1>
    <WalkPath points={walk.data.locationPoints} />
  </body>
</html>
