---
import { getCollection, render } from 'astro:content';
import { walkTitle } from '../../walkTitle';

export async function getStaticPaths() {
  const walks = await getCollection('walks');
  return walks.map((walk) => ({ params: { id: walk.id }, props: { walk } }));
}

const { walk } = Astro.props;
const { Content } = await render(walk);
const title = walkTitle(walk.data.date);
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    <h1><a href="/">Lost &amp; Found</a></h1>
    <h2>{title}</h2>
    <div class="path">
      <img src={walk.data.path} alt={`Path of the walk on ${title}`} />
    </div>
    <Content />
  </body>
</html>

<style>
  /* As wide as two homepage boxes plus the gap between them (300 + 10 + 300). */
  .path {
    position: relative;
    width: 610px;
    max-width: 100%;
    aspect-ratio: 1;
    background: #e4e4e4;
  }

  .path img {
    position: absolute;
    inset: 32px;
    width: calc(100% - 64px);
    height: calc(100% - 64px);
    object-fit: contain;
  }

  h1 a {
    color: black;
  }
</style>
