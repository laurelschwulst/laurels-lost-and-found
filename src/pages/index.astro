---
import { getCollection } from 'astro:content';
import { walkTitle } from '../walkTitle';

// Newest first. Ids are dates (plus -2, -3 for extra walks that day), so they sort as text.
const walks = (await getCollection('walks')).sort((a, b) => b.id.localeCompare(a.id));
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Lost &amp; Found</title>
  </head>
  <body>
    <h1>Lost &amp; Found</h1>
    <ul>
      {walks.map((walk) => (
        <li><a href={`/walks/${walk.id}/`}>{walkTitle(walk.data.date, walk.data.duration)}</a></li>
      ))}
    </ul>
  </body>
</html>
